{
  "manifest_version": 3,
  "name": "PCC Class Search — Rate My Professors",
  "version": "1.0.0",
  "description": "Shows Rate My Professors ratings beside instructors on Pasadena City College's public class search.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.ratemyprofessors.com/*"],
  "content_scripts": [
    {
      "matches": ["https://findclasses.pasadena.edu/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PCC Rate My Professors", "default_popup": "popup.html" }
}
